{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Garde-temps d'exception et montre de luxe dans le catalogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "collectionId": { "type": "string" },
        "collectionName": { "type": "string" },
        "categoryId": { "type": "string" },
        "gender": { "type": "string", "enum": ["homme", "femme", "unisex", "mixte"] },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "price": { "type": "number" },
        "promoPrice": { "type": ["number", "null"] },
        "promotionalPrice": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "stock": { "type": "integer" },
        "lowStockThreshold": { "type": "integer" },
        "images": { "type": "array", "items": { "type": "string" } },
        "coverImage": { "type": "string" },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "totalOrders": { "type": "integer" },
        "totalQuantitySold": { "type": "integer" },
        "slug": { "type": "string" },
        "reference": { "type": "string" },
        "specifications": { "type": "object" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "brand", "collectionId", "price", "stock", "images"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Collection horlogère ou catégorie de garde-temps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "isActive"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Profil de compte client de la maison horlogère",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "ordersCount": { "type": "integer" },
        "totalSpent": { "type": "number" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Commande d'acquisition de garde-temps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "city": { "type": "string" },
            "address": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "name": { "type": "string" },
              "brand": { "type": "string" },
              "image": { "type": "string" },
              "unitPrice": { "type": "number" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" },
              "subtotal": { "type": "number" }
            },
            "required": ["productId", "quantity", "subtotal"]
          }
        },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded", "not_required"] },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "processing", "preparing", "shipped", "delivered", "cancelled"] },
        "status": { "type": "string" },
        "whatsappOrder": { "type": "boolean" },
        "whatsappMessageSent": { "type": "boolean" },
        "notes": { "type": "string" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["items", "total"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Panier d'achat persistant client",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "integer" }
            },
            "required": ["productId", "quantity"]
          }
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "items"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Configuration globale de la boutique horlogère",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "whatsappDefaultMessage": { "type": "string" },
        "currency": { "type": "string" },
        "defaultLowStockThreshold": { "type": "integer" },
        "shippingEnabled": { "type": "boolean" },
        "shippingFee": { "type": "number" },
        "shippingMessage": { "type": "string" },
        "socialLinks": { "type": "object" },
        "contactInformation": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName", "whatsappNumber", "currency"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Profil administrateur CMS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "manager"] },
        "displayName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Historique des opérations d'administration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "object" },
        "summary": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalogue des montres de prestige"
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Collections de montres"
    },
    "/categories/{categoryId}": {
      "schema": "Collection",
      "description": "Catégories horlogères (compatibilité)"
    },
    "/customers/{userId}": {
      "schema": "Customer",
      "description": "Comptes et profils clients"
    },
    "/users/{userId}": {
      "schema": "Customer",
      "description": "Comptes utilisateurs (compatibilité)"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Commandes clients"
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "Paniers clients persistants"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Paramètres de la boutique horlogère"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Registre des administrateurs autorisés"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Journal d'audit administratif"
    }
  }
}
