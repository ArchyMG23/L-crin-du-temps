{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Premium luxury watch item in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "price": { "type": "number" },
        "promotionalPrice": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "categoryId": { "type": "string" },
        "gender": { "type": "string", "enum": ["homme", "femme", "mixte"] },
        "brand": { "type": "string" },
        "reference": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "integer" },
        "lowStockThreshold": { "type": "integer" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "specifications": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "price", "currency", "categoryId", "gender", "brand", "stock", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Watch category or collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "active"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer or administrator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "city": { "type": "string" },
            "address": { "type": "string" },
            "notes": { "type": "string" }
          },
          "required": ["name", "phone", "city", "address"]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "image": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" },
              "subtotal": { "type": "number" }
            },
            "required": ["productId", "name", "price", "quantity", "subtotal"]
          }
        },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "shipped", "delivered", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded", "not_required"] },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "whatsappMessageSent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customer", "items", "total", "status", "paymentStatus", "paymentMethod"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and preferences",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "logo": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "currency": { "type": "string" },
        "defaultLowStockThreshold": { "type": "integer" },
        "shippingEnabled": { "type": "boolean" },
        "shippingFee": { "type": "number" },
        "shippingMessage": { "type": "string" },
        "socialLinks": { "type": "object" },
        "contactInformation": { "type": "object" }
      },
      "required": ["storeName", "whatsappNumber", "currency"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator user profile in the boutique",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "manager"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System and administrative action audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": {
          "type": "object",
          "properties": {
            "uid": { "type": "string" },
            "email": { "type": "string" }
          },
          "required": ["uid", "email"]
        },
        "summary": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "performedBy", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of watches"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Watch categories & collections"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer accounts and profiles"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "General boutique configurations"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrator registry and roles"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative actions audit log"
    }
  }
}
