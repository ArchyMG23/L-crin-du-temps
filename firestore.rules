rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email in [
        "gabrielyombi311@gmail.com",
        "admin@horlogerie-prestige.com",
        "contact@horlogerie-prestige.com"
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin" ||
        request.auth.token.role == "owner" ||
        request.auth.token.firebase.sign_in_provider == "anonymous" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isSuperAdminEmail()
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection:
    // Public can read active products.
    // Admin has full management access (create, update, delete).
    // Customers can atomically decrement stock during purchase without being able to alter price or other details.
    match /products/{productId} {
      allow get, list: if resource.data.isActive == true || resource.data.active == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Controlled stock decrement during customer checkout
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'totalOrders', 'orderCount', 'totalQuantitySold', 'updatedAt'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.price == resource.data.price
        && request.resource.data.name == resource.data.name
        && request.resource.data.brand == resource.data.brand
      );
    }

    // Collections collection:
    // Public can read active collections. Admin has full management access.
    match /collections/{collectionId} {
      allow get, list: if resource.data.isActive == true || resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection (backward compatibility):
    // Public can read active categories. Admin has full management access.
    match /categories/{categoryId} {
      allow get, list: if resource.data.isActive == true || resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Customers collection:
    // Strict ABAC / PII Protection:
    // - Customers can only get their own profile document (uid == userId).
    // - Role, totalSpent, and ordersCount CANNOT be altered by customers.
    // - Only administrators can list all customer records or delete accounts.
    match /customers/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'customer') || isAdmin();
      allow update: if (
        isSignedIn() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalSpent', 'ordersCount'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Users (Legacy customer profiles) collection:
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'customer') || isAdmin();
      allow update: if (
        isSignedIn() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalSpent', 'ordersCount'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection:
    // Strict ABAC and Pricing Integrity:
    // - Orders created must have pending status and matching authenticated UID if signed in.
    // - Customers can only view/list their own orders.
    // - Only administrators can read all, update statuses, or delete orders.
    match /orders/{orderId} {
      allow create: if request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.subtotal is number
                    && request.resource.data.subtotal >= 0
                    && request.resource.data.status in ['pending', 'confirmed']
                    && request.resource.data.paymentStatus in ['pending', 'not_required']
                    && (!isSignedIn() || request.resource.data.customerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
      allow update, delete: if isAdmin();
    }

    // Carts collection:
    // Cart owner has full access; administrator can inspect.
    match /carts/{userId} {
      allow get, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }

    // Store settings:
    // Public can read store preferences (currency, contact, WhatsApp).
    // ONLY administrator can write/update settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Health check test connection:
    match /test/{testId} {
      allow read: if true;
    }

    // Audit logs (e.g. system resets, administrative actions):
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admins registry:
    // Only verified super-admin emails, existing admins, or local sandbox anonymous managers can register admin document.
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == adminId && (
          isSuperAdminEmail() ||
          request.auth.token.firebase.sign_in_provider == "anonymous"
        ))
      );
      allow update, delete: if isAdmin();
    }
  }
}
