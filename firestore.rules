rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin" ||
        request.auth.token.role == "owner" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "gabrielyombi311@gmail.com" ||
        request.auth.token.email == "admin@horlogerie-prestige.com" ||
        request.auth.token.email == "contact@horlogerie-prestige.com"
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection:
    // Public can read active products. Admin has full management access.
    match /products/{productId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection:
    // Public can read active categories. Admin has full management access.
    match /categories/{categoryId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Users (Customer profiles) collection:
    // Strict ABAC / PII Protection:
    // - Customers can only get and update their own profile document (uid == userId).
    // - Customers cannot self-assign or elevate role to 'admin' (locked to 'customer').
    // - Only verified administrators can list all customer records.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'customer') || isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection:
    // Strict ABAC and Pricing Integrity:
    // - Valid orders can be created by authenticated customers (or guest checkout under strict format checks).
    // - New order status and paymentStatus are strictly locked to 'pending'.
    // - Customers can only view/list their own orders (customerId == request.auth.uid).
    // - Only administrators can read all, update statuses, or delete orders.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderNumber is string
                    && request.resource.data.orderNumber.matches('^CMD-[0-9]{4}-[0-9]{5,7}$')
                    && request.resource.data.status == 'pending'
                    && request.resource.data.paymentStatus == 'pending'
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.name.size() > 0
                    && request.resource.data.customer.name.size() <= 100
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.phone.size() >= 8
                    && request.resource.data.customer.phone.size() <= 30
                    && request.resource.data.customer.city is string
                    && request.resource.data.customer.city.size() > 0
                    && request.resource.data.customer.city.size() <= 100
                    && request.resource.data.customer.address is string
                    && request.resource.data.customer.address.size() > 0
                    && request.resource.data.customer.address.size() <= 300
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.subtotal is number
                    && request.resource.data.subtotal >= 0
                    && request.resource.data.shipping is number
                    && request.resource.data.shipping >= 0
                    && request.resource.data.total is number
                    && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shipping;
      allow get: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Store settings:
    // Public can read store preferences (currency, contact, WhatsApp).
    // Admin or valid store configuration payload can write.
    function isValidStoreSettings(data) {
      return data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 100
          && data.whatsappNumber is string && data.whatsappNumber.size() >= 4 && data.whatsappNumber.size() <= 40
          && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isValidStoreSettings(request.resource.data);
    }

    // Health check test connection:
    match /test/{testId} {
      allow read: if true;
    }

    // Audit logs (e.g. system resets, administrative actions):
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admins registry:
    // Authenticated users can only read their own document; admins can list and manage all admin accounts.
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list, write: if isAdmin();
    }
  }
}
